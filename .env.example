BUFFER_MINUTES=10
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_THREADS=2
# copy avoids continuous video encoding. Use encode for incompatible sources.
CAPTURE_MODE=copy
# Prefer this source quality when available (does not resize in copy mode).
CAPTURE_MAX_HEIGHT=720
# Optional absolute path; defaults to backend/storage.
# STORAGE_DIR=C:/LiveClip/storage
# Optional FFmpeg override; otherwise use PATH or bundled imageio-ffmpeg.
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Phase 7 official OAuth apps. Safe mock mode is used while these remain empty.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
OAUTH_CALLBACK_BASE=http://127.0.0.1:8000
